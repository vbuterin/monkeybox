# Explicit guest-loopback compatibility for granted host ports only.
set -euo pipefail
ports=$1
shift
pids=()
cleanup() {
    for pid in "${pids[@]}"; do kill "$pid" 2>/dev/null || true; done
    for pid in "${pids[@]}"; do wait "$pid" 2>/dev/null || true; done
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
# The relay's upstream is the guest's default gateway — the host-side end of
# the virtual network. The guest boots without an IPv4 route when the host had
# no IPv4 route while the sandbox was starting (network down or still coming
# up). That must fail with a plain line instead of a traceback from a probe
# that assumed the route was there; a /30 guest subnet still names its gateway
# (network address + 1) if only the default route is missing.
gateway=$(@@PYTHON@@ - /proc/net/route <<'PY'
import socket, struct, sys

rows = open(sys.argv[1]).read().splitlines()[1:]
for row in rows:
    fields = row.split()
    # Destination 0.0.0.0 with a real gateway is the default route.
    if len(fields) > 7 and fields[1] == '00000000' and fields[2] != '00000000':
        print(socket.inet_ntoa(struct.pack('<I', int(fields[2], 16))))
        raise SystemExit(0)
for row in rows:
    fields = row.split()
    if len(fields) > 7 and fields[2] == '00000000' and fields[7] == 'FFFFFFFC':
        # /proc/net/route stores addresses little-endian; the gateway is the
        # last octet of the subnet address plus one, not a bare integer + 1.
        network = socket.inet_ntoa(struct.pack('<I', int(fields[1], 16)))
        octets = network.split('.')
        print('.'.join(octets[:3] + [str(int(octets[3]) + 1)]))
        raise SystemExit(0)
raise SystemExit('mbox: guest has no IPv4 network (the host had no IPv4 route '
                 'while the sandbox was starting); host loopback relay cannot '
                 'start — retry once the host network is up')
PY
)
for port in $ports; do
    @@SOCAT@@ "TCP4-LISTEN:$port,bind=127.0.0.1,reuseaddr,fork" "TCP4:$gateway:$port" &
    pids+=("$!")
done
# Connect locally to confirm listeners are ready, not to send service requests.
@@PYTHON@@ - "$ports" <<'PY'
import socket,sys,time
for port in sys.argv[1].split():
    for attempt in range(100):
        try:
            with socket.create_connection(('127.0.0.1', int(port)), timeout=.1):
                break
        except OSError:
            time.sleep(.02)
    else:
        raise SystemExit('mbox: guest loopback relay did not become ready')
PY
for pid in "${pids[@]}"; do
    kill -0 "$pid" 2>/dev/null || { echo 'mbox: loopback relay exited' >&2; exit 1; }
done
export PATH="@@PI_BIN@@:$PATH"
"$@"

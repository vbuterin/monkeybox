# Monkeybox defaults. Edit freely; upgrades never overwrite ~/.mboxrc.
# name: flags [-- application arguments]. Quotes and # comments work; no shell code.
# -d = private app home, -x = exclusive use. No implicit cwd grant with -d.
# --optional-file / --read-only skip missing paths; -f requires existing paths.
firefox:          -dvaicx -m 8192 --optional-file ~/Downloads ~/Screenshots
chromium:         -dvaicx -m 4096 --optional-file ~/Downloads
google-chrome:    -dvaicx -m 4096 --optional-file ~/Downloads
brave:            -dvaicx -m 4096 --optional-file ~/Downloads
signal-desktop:   -dvaicx --desktop-layout tabbed -m 4096 --optional-file ~/Downloads
transmission-gtk: -dvicx -m 4096 --optional-file ~/Downloads
# Wine apps: run the wine binary itself (`mbox -- /nix/store/*/bin/wine app.exe`),
# the entry is keyed on that basename. -d keeps one persistent prefix per app,
# -x stops two wines from sharing it. Add -i for programs that need the network.
# WINEDLLOVERRIDES keeps mscoree from spawning the wine-mono dialog at boot.
wine:             -dvx -m 8192 --env WINEDLLOVERRIDES=mscoree,mshtml=
mplayer:          -vac --no-internet -m 2048
evince:           -vc --no-internet -m 2048
feh:              -vc --no-internet -m 2048
libreoffice:      -vc --no-internet -m 4096
gimp:             -vc --no-internet -m 4096
# Agent resources only. No credentials, host service ports or live Signal account.
pi: -i --read-only ~/.pi/agent/models.json ~/.pi/agent/skills ~/.pi/agent/prompts ~/.pi/agent/themes ~/.pi/agent/extensions ~/.agents/skills ~/.agents/mcp.json

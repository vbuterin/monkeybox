+    // Deterministic PID-reuse fixture: the terminated run names the test
+    // process, not a real VM. Never signal it. No host state or VM is involved.
+    #[tokio::test]
+    #[cfg(unix)]
+    async fn test_prepare_create_target_terminated_reused_pid() {
+        let temp = tempfile::Builder::new()
+            .prefix("msb-pid")
+            .tempdir_in("/tmp")
+            .unwrap();
+        let pools = open_test_pools(&temp.path().join("test.db")).await;
+        let sandbox_dir = temp.path().join("sandboxes/reused");
+        fs::create_dir_all(&sandbox_dir).unwrap();
+        let mut config = test_config("reused");
+        let sandbox_id = LocalBackend::insert_sandbox_record(pools.write(), &config)
+            .await
+            .unwrap();
+        LocalBackend::update_sandbox_status(pools.write(), sandbox_id, SandboxStatus::Stopped)
+            .await
+            .unwrap();
+        run_entity::Entity::insert(run_entity::ActiveModel {
+            sandbox_id: Set(sandbox_id),
+            pid: Set(Some(std::process::id() as i32)),
+            status: Set(run_entity::RunStatus::Terminated),
+            terminated_at: Set(Some(chrono::Utc::now().naive_utc())),
+            ..Default::default()
+        })
+        .exec(pools.write())
+        .await
+        .unwrap();
+        config.replace_existing = true;
+        let run_dir = temp.path().join("run");
+
+        // A terminal row is not permission to delete a live endpoint.
+        let paths = microsandbox_runtime::ipc::sandbox_socket_paths(&run_dir, "reused");
+        fs::create_dir_all(&paths.canonical_dir).unwrap();
+        let listener = std::os::unix::net::UnixListener::bind(&paths.control).unwrap();
+        let error = LocalBackend::prepare_create_target(&pools, &config, &sandbox_dir, &run_dir)
+            .await
+            .unwrap_err();
+        assert!(error.to_string().contains("runtime endpoint is still live"));
+        assert!(sandbox_dir.exists());
+        assert!(
+            sandbox_entity::Entity::find_by_id(sandbox_id)
+                .one(pools.read())
+                .await
+                .unwrap()
+                .is_some()
+        );
+        drop(listener);
+
+        // The socket file remains, but there is no listening owner. The old
+        // PID must not prevent replacement or cause an unrelated process kill.
+        LocalBackend::prepare_create_target(&pools, &config, &sandbox_dir, &run_dir)
+            .await
+            .unwrap();
+        assert!(LocalBackend::pid_is_alive(std::process::id() as i32));
+        assert!(!sandbox_dir.exists());
+        assert!(
+            sandbox_entity::Entity::find_by_id(sandbox_id)
+                .one(pools.read())
+                .await
+                .unwrap()
+                .is_none()
         );
     }
 

--- a/sway/desktop/transaction.c
+++ b/sway/desktop/transaction.c
@@ -9,6 +9,7 @@
 #include "sway/desktop/transaction.h"
 #include "sway/input/cursor.h"
 #include "sway/input/input-manager.h"
+#include "sway/input/seat.h"
 #include "sway/output.h"
 #include "sway/server.h"
 #include "sway/tree/container.h"
@@ -763,6 +764,16 @@
 	transaction_apply(server.queued_transaction);
 	arrange_root(root);
 	cursor_rebase_all();
+	// Reconcile genuinely missing keyboard focus through the seat's normal
+	// policy checks and pressed-key bookkeeping. Healthy focus is a no-op.
+	struct sway_seat *seat;
+	wl_list_for_each(seat, &server.input->seats, link) {
+		struct sway_node *focus = seat_get_focus(seat);
+		if (focus && !seat->focused_layer && !server.session_lock.lock &&
+				!seat->wlr_seat->keyboard_state.focused_surface) {
+			seat_set_focus(seat, focus);
+		}
+	}
 	transaction_destroy(server.queued_transaction);
 	server.queued_transaction = NULL;
 

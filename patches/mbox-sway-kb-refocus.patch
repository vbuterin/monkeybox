 	}
 	seat->wlr_seat->data = seat;
+	if (!mbox_heal_timer) {
+		mbox_heal_timer = wl_event_loop_add_timer(server.wl_event_loop, mbox_heal_tick, NULL);
+	}
+	if (mbox_heal_timer) {

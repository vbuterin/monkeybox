--- a/sway/input/seat.c
+++ b/sway/input/seat.c
@@ -968,5 +968,24 @@
 	seat_device_destroy(seat_device);
 
+	// A short-lived virtual keyboard may have been the active seat keyboard.
+	// Restore a surviving device now, not on the next key: an input-method
+	// grab can consume that next key without ever selecting a seat keyboard.
+	// Changing keyboards updates keymap/modifiers; it must NOT cycle focus.
+	if (!wlr_seat_get_keyboard(seat->wlr_seat)) {
+		struct sway_seat_device *device;
+		wl_list_for_each(device, &seat->devices, link) {
+			if (!device->keyboard || !device->keyboard->wlr->keymap) {
+				continue;
+			}
+			struct wlr_keyboard *keyboard = device->keyboard->wlr;
+			if (keyboard->group) {
+				keyboard = &keyboard->group->keyboard;
+			}
+			wlr_seat_set_keyboard(seat->wlr_seat, keyboard);
+			break;
+		}
+	}
+
 	seat_update_capabilities(seat);
 }
 
@@ -1130,6 +1149,19 @@
 static void seat_set_workspace_focus(struct sway_seat *seat, struct sway_node *node) {
 	struct sway_node *last_focus = seat_get_focus(seat);
 	if (last_focus == node) {
+		// Repair only genuinely missing keyboard focus. A keymap change or
+		// a click on an already-focused view is not evidence of lost focus.
+		// Never steal focus from a popup, layer, grab or session lock.
+		if (node && node->type == N_CONTAINER && node->sway_container->view &&
+				!seat->focused_layer && !wlr_seat_keyboard_has_grab(seat->wlr_seat) &&
+				!seat->wlr_seat->keyboard_state.focused_surface) {
+			struct sway_view *view = node->sway_container->view;
+			if (view->surface && view->surface->mapped &&
+					seat_is_input_allowed(seat, view->surface)) {
+				seat_keyboard_notify_enter(seat, view->surface);
+				sway_input_method_relay_set_focus(&seat->im_relay, view->surface);
+			}
+		}
 		return;
 	}
 
